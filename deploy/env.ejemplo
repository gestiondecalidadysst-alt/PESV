# Configuración de producción. ./deploy/instalar.sh la copia a deploy/.env y genera los secretos.
# Nunca subas deploy/.env al repositorio.

# --- Dominio y HTTPS -----------------------------------------------------------
# El dominio debe apuntar (registro A) a la IP del servidor antes de iniciar.
# Para probar sin dominio propio: <ip-con-guiones>.sslip.io, por ejemplo 203-0-113-10.sslip.io
DOMINIO=pesv.tuempresa.co
# Correo para Let's Encrypt (avisos de vencimiento del certificado).
ACME_EMAIL=sistemas@tuempresa.co
TZ=America/Bogota

# --- Secretos (instalar.sh los genera; no los cambies después o se pierden datos) ---
POSTGRES_PASSWORD=
APP_DB_PASSWORD=
# Firma de sesiones (mínimo 32 caracteres). Cambiarlo cierra todas las sesiones.
SESSION_SECRET=
# Cifra las claves de IA y secretos de webhooks. ¡Si se pierde, hay que volver a escribirlas!
ENCRYPTION_KEY=

# --- Correo (SMTP) ---------------------------------------------------------------
# Sin SMTP_HOST la plataforma funciona, pero no envía correos (recuperación, invitaciones, alertas).
# Ejemplos:
#   Gmail / Google Workspace: smtp.gmail.com, 587, SMTP_SECURE=false, contraseña de aplicación
#   Zoho: smtp.zoho.com, 465, SMTP_SECURE=true
#   Brevo: smtp-relay.brevo.com, 587
#   Amazon SES: email-smtp.us-east-1.amazonaws.com, 587
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM=PESV <no-responder@tuempresa.co>

# --- Archivos ---------------------------------------------------------------------
# local: en un volumen del servidor (incluido en las copias de seguridad).
# s3: en un bucket S3 o compatible (MinIO, Cloudflare R2, DigitalOcean Spaces).
STORAGE_DRIVER=local
S3_BUCKET=
S3_REGION=us-east-1
S3_ENDPOINT=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# --- Copias de seguridad -------------------------------------------------------------
# Hora local de la copia diaria y días que se conservan en ./respaldos.
RESPALDO_HORA=02:30
RESPALDO_DIAS=14
# Opcional: URL que se llama tras cada copia exitosa (monitor «push» de Uptime Kuma).
RESPALDO_AVISO_URL=
