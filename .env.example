# Copia este archivo como .env y ajusta los valores. Nunca subas el .env al repositorio.

# Rol dueño del esquema: solo para migraciones y semillas.
DATABASE_ADMIN_URL=postgres://pesv_owner:pesv_owner_dev@localhost:5432/pesv
# Rol de la aplicación (sin privilegios de dueño, para que RLS siempre aplique).
DATABASE_URL=postgres://pesv_app:pesv_app_dev@localhost:5432/pesv
# Contraseña con la que la migración crea el rol pesv_app si no existe.
APP_DB_PASSWORD=pesv_app_dev

# API
PORT=3000
CORS_ORIGINS=http://localhost:5173
WEB_URL=http://localhost:5173
# Secreto para firmar sesiones (mínimo 32 caracteres): openssl rand -base64 48
SESSION_SECRET=
# Clave de 32 bytes para cifrar credenciales de IA y secretos de webhooks: openssl rand -base64 32
ENCRYPTION_KEY=
# Archivos de evidencias: local (carpeta) o s3 (también MinIO o compatibles)
STORAGE_DRIVER=local
STORAGE_DIR=./storage
# S3_BUCKET=
# S3_REGION=us-east-1
# S3_ENDPOINT=
# Desactiva el despachador de webhooks y las tareas programadas (útil en pruebas)
# DISABLE_WORKERS=true

# Web (opcional): URL pública de la API. En desarrollo Vite redirige /api a localhost:3000.
# VITE_API_URL=https://api.tu-dominio.com/api
